# Cloudflare Pages Cache Headers
# https://developers.cloudflare.com/pages/configuration/headers/

# HTML files - short cache, always revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# Hashed assets - immutable, cache for 1 year
# These files have content hashes in filenames (e.g., styles.a1b2c3d4.css)
/*.*.css
  Cache-Control: public, max-age=31536000, immutable

/*.*.js
  Cache-Control: public, max-age=31536000, immutable

/scripts/*.*.js
  Cache-Control: public, max-age=31536000, immutable

# Non-hashed JS modules - cache for 1 week with revalidation
/scripts/*.js
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Images - cache for 1 month
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Favicon - cache for 1 week
/favicon.svg
  Cache-Control: public, max-age=604800

# Fonts (if self-hosted in future)
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# RSS feed - short cache
/blog/feed.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=600
