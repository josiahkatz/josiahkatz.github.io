---
layout: layouts/base.njk
title: Blog
description: Writing on design leadership, product craft, and creative work.
permalink: /blog/
mainClass: blog
---
<section class="blog-index">
  <div class="blog-header">
    <h1 class="blog-title">Blog</h1>
    <p class="blog-subtitle">Writing on design leadership, product craft, and creative work.</p>
    <div class="blog-actions">
      <a href="/blog/feed.xml">RSS Feed</a>
      <a href="/blog/tags/">All Tags</a>
    </div>
  </div>
  <div class="blog-list">
    {% for post in collections.blogPosts %}
      <article class="post-card">
        <p class="post-meta">
          <time datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time>
        </p>
        <h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.summary %}
          <p class="post-summary">{{ post.data.summary }}</p>
        {% endif %}
        {% if post.data.tags %}
          <div class="post-tags">
            {% for tag in post.data.tags | sort %}
              {% if tag != "blog" %}
                <a href="/blog/tags/{{ tag | slugify }}/">{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </div>
</section>
