---
layout: layouts/base.njk
mainClass: blog
---
<section class="blog-index">
  <div class="blog-header">
    <h1 class="blog-title">Tag: {{ tag }}</h1>
    <p class="blog-subtitle">Posts tagged with “{{ tag }}”.</p>
  </div>
  <div class="blog-list">
    {% set taggedPosts = collections.blogPosts | filterByTag(tag) %}
    {% for post in taggedPosts %}
      <article class="post-card">
        <p class="post-meta">
          <time datetime="{{ post.date.toISOString() }}">{{ post.date | readableDate }}</time>
        </p>
        <h2 class="post-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
        {% if post.data.summary %}
          <p class="post-summary">{{ post.data.summary }}</p>
        {% endif %}
        {% if post.data.tags %}
          <div class="post-tags">
            {% for tag in post.data.tags | sort %}
              {% if tag != "blog" %}
                <a href="/blog/tags/{{ tag | slugify }}/">{{ tag }}</a>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </article>
    {% endfor %}
  </div>
  <p class="post-back"><a href="/blog/">Back to Blog</a></p>
</section>
