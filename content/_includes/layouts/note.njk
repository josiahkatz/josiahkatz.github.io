---
layout: layouts/base.njk
mainClass: blog
---
<article class="note-page">
  <header class="post-header">
    <p class="post-meta">
      <time datetime="{{ page.date.toISOString() }}">{{ page.date | readableDate }}</time>
    </p>
    <h1 class="post-title">{{ text }}</h1>
    {% if url %}
      <p class="note-link"><a href="{{ url }}" target="_blank" rel="noopener">{{ url }}</a></p>
    {% endif %}
  </header>
  {% if image %}
    <img class="note-image" src="{{ image }}" alt="">
  {% endif %}
  {% if content %}
    <div class="note-body">
      {{ content | safe }}
    </div>
  {% endif %}
  <p class="post-back"><a href="/notes/">Back to Notes</a></p>
</article>
