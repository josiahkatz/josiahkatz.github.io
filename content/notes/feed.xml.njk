---
permalink: /notes/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>{{ site.name }} Notes</title>
    <link>{{ "/notes/" | absoluteUrl(site.url) }}</link>
    <description>Short updates and quick links.</description>
    <language>en-us</language>
    {% for note in collections.notes | slice(0, 30) %}
      <item>
        <title>{{ note.data.text | safe }}</title>
        <link>{{ note.url | absoluteUrl(site.url) }}</link>
        <guid>{{ note.url | absoluteUrl(site.url) }}</guid>
        <pubDate>{{ note.date.toUTCString() }}</pubDate>
        <description><![CDATA[{{ note.data.text }}{% if note.data.url %} — {{ note.data.url }}{% endif %}]]></description>
      </item>
    {% endfor %}
  </channel>
</rss>
